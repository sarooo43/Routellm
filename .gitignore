# Dependencies
node_modules/
.venv/

# Builds
dist/
coverage/

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Env & secrets
.env
.env.*
!.env.example
# Explicit (belt and braces): backend env files must never be committed. The
# Hugging Face Space is PUBLIC, so a leaked DATABASE_URL/REDIS_URL/provider key
# would be world-readable and is only removable by rewriting history.
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
# Local-only deployment scratch (real Neon/Upstash values for manual testing).
.env.hf.local
backend/.env.hf.local

# Databases (local demo/dev artifacts)
*.db
*.sqlite3

# ML artifacts (regenerate via scripts; don't ship the 87MB embedder pickle
# or synthetic/local training data to the repo)
backend/app/ml_models/*.pkl
backend/scripts/training_data/

# Runtime scratch (non-Hugging Face local runs only; HF uses /tmp)
backend/.runtime/

# Logs & caches
*.log
.vite/
node_modules/.vite/
.wrangler/

# OS noise
Thumbs.db
.DS_Store
