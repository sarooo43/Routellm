{
  // Cloudflare Workers deployment for the RouteLLM dashboard + API proxy.
  //
  // IMPORTANT: Cloudflare Workers cannot run the Python FastAPI backend,
  // PostgreSQL, or Redis. Host the backend elsewhere (for example the Caddy
  // docker-compose deployment) and set ROUTELLM_API_ORIGIN to its HTTPS origin.
  //
  //   wrangler secret put ROUTELLM_API_ORIGIN
  //   # or set a Worker variable in the Cloudflare dashboard:
  //   # ROUTELLM_API_ORIGIN = https://api.example.com
  //
  // The frontend is built with same-origin API calls by default. This Worker
  // proxies /api/* and /v1/* to ROUTELLM_API_ORIGIN, so browsers/webhooks can
  // use https://<your-worker-domain>/api/v1/route once the backend is reachable.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "routellm",
  "main": "cloudflare/worker.js",
  // Pin a stable, historically released Workers runtime behavior set.
  // Do not bump this to "today": CI clocks/Cloudflare API validation are UTC,
  // and a local calendar date can accidentally be in the future (error 10021).
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/v1/*",
      "/health",
      "/docs",
      "/docs/*",
      "/openapi.json",
      "/redoc"
    ]
  },
  // Matches the Cloudflare dashboard observability snapshot.
  // Top-level enabled:false keeps collection off; the nested settings are
  // retained so a later enablement uses the same sampling/persistence policy.
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  }
}
