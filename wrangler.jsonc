{
  // Cloudflare Workers deployment for the RouteLLM dashboard + API proxy.
  //
  // IMPORTANT: Cloudflare Workers cannot run the Python FastAPI backend,
  // PostgreSQL, or Redis. Host the backend elsewhere (for example the Caddy
  // docker-compose deployment) and set ROUTELLM_API_ORIGIN to its HTTPS origin.
  //
  //   wrangler secret put ROUTELLM_API_ORIGIN
  //   # or set a Worker variable in the Cloudflare dashboard:
  //   # ROUTELLM_API_ORIGIN = https://api.example.com
  //
  // The frontend is built with same-origin API calls by default. This Worker
  // proxies /api/* and /v1/* to ROUTELLM_API_ORIGIN, so browsers/webhooks can
  // use https://<your-worker-domain>/api/v1/route once the backend is reachable.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "routellm",
  "main": "cloudflare/worker.js",
  // The backend origin this Worker proxies /api/*, /v1/* and /health to.
  //
  // It lives HERE, in git, on purpose. As a dashboard-only variable it was
  // silently lost on every deploy that did not pass --keep-vars, and the whole
  // dashboard then 503'd with `routellm_backend_not_configured`. In config it is
  // versioned, shows up in `wrangler deploy --dry-run` bindings, and survives
  // every deploy and every Workers Build.
  //
  // This is PUBLIC information (a URL, not a secret). A dashboard variable still
  // overrides it if you ever need to point at a different backend.
  "vars": {
    // BACKEND_URL is the primary name; ROUTELLM_API_ORIGIN is the legacy
    // alias still honored by cloudflare/worker.js and any dashboard override.
    "BACKEND_URL": "https://saboornotgonna-routellm.hf.space",
    "ROUTELLM_API_ORIGIN": "https://saboornotgonna-routellm.hf.space"
  },
  // Pin a stable, historically released Workers runtime behavior set.
  // Do not bump this to "today": CI clocks/Cloudflare API validation are UTC,
  // and a local calendar date can accidentally be in the future (error 10021).
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/v1/*",
      "/health",
      "/docs",
      "/docs/*",
      "/openapi.json",
      "/redoc"
    ]
  },
  // Matches the Cloudflare dashboard observability snapshot.
  // Top-level enabled:false keeps collection off; the nested settings are
  // retained so a later enablement uses the same sampling/persistence policy.
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  }
}
