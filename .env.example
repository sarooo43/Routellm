# RouteLLM root environment — used by docker-compose.
# Copy to .env and fill in values:   cp .env.example .env

# --- Public HTTPS domain (Caddy) ---
# Point this DNS name at the host running docker compose and open ports 80/443.
# Caddy obtains/renews a Let's Encrypt certificate automatically.
# Use localhost for local experiments (Caddy internal CA).
DOMAIN=localhost

# --- Operator provider API keys (legacy/demo fallback) ---
# Per-caller BYOK keys stored in the dashboard override these for that caller.
# Requests route gracefully into structured "all_providers_failed" responses
# when neither BYOK nor operator keys are available.
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# --- BYOK provider-key encryption (required for Provider Keys UI) ---
# Generate a Fernet key and paste it here. Do NOT commit the real .env.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without this, saving provider keys and BYOK routing fail closed with HTTP 503.
PROVIDER_KEY_ENCRYPTION_KEY=

# --- Deployment environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Rate limit on POST /api/v1/route (slowapi syntax) ---
ROUTE_RATE_LIMIT=30/minute

# --- Lightweight demo API keys (Phase 16) ---
# No env var is needed: keys are generated via POST /api/v1/keys/generate and
# stored in the database as SHA-256 hashes only. Protected endpoints require
# X-API-Key. This is demo/portfolio auth, NOT production OAuth/multi-tenant auth.

# --- Postgres credentials (used by BOTH the postgres service and the
# backend's DATABASE_URL so they cannot drift apart) ---
POSTGRES_USER=routellm
POSTGRES_PASSWORD=changeme
POSTGRES_DB=routellm

# NOTE: DATABASE_URL / REDIS_URL are intentionally NOT set here — inside the
# compose network the backend must reach the services by hostname
# (postgres / redis), which docker-compose.yml injects via `environment`.
