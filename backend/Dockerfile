# RouteLLM backend — single-container image (API + built dashboard).
#
#   docker build -t routellm ./backend
#   docker run --rm -p 8000:8000 -v routellm-data:/data routellm
#
# Optional convenience only: the supported local path is `python run.py`.
# The image needs no Postgres and no Redis — SQLite and the in-process store
# are the defaults — and it keeps user state in a volume so restarts do not
# lose the database or the generated BYOK encryption key.

# ---------- Stage 1: build the dashboard ----------
FROM node:20-alpine AS frontend

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
# Same-origin is the default and correct here: the backend serves this bundle.
ARG VITE_API_BASE_URL=
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

# ---------- Stage 2: runtime ----------
FROM python:3.12-slim

# No .pyc files inside the image; logs stream straight to stdout.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ROUTELLM_DATA_DIR=/data \
    PORT=8000 \
    HOST=0.0.0.0

WORKDIR /app

# requirements first so the dependency layer caches independently of app code.
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/app ./app
# The served dashboard (backend/app/frontend.py looks for ../frontend/dist).
COPY --from=frontend /app/dist /app/frontend/dist

# Bind to 0.0.0.0 inside the container; publish to the HOST loopback only:
#   docker run -p 127.0.0.1:8000:8000 ...
EXPOSE 8000

# Run as an unprivileged user, and own the data volume so SQLite can write.
RUN useradd --create-home --shell /usr/sbin/nologin appuser \
    && mkdir -p /data \
    && chown -R appuser:appuser /data /app
USER appuser

VOLUME ["/data"]

# /health always answers 200 (it reports dependency state in the body), so it
# is the right liveness probe for a single-process container.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4)"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
