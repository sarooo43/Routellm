# ---------------------------------------------------------------------------
# RouteLLM — local-first configuration
#
# NOTHING in this file is required to run locally. `python run.py` starts with
# SQLite in ./data, an in-process Redis substitute, chaos mode on and no API
# keys. Copy this file to backend/.env only when you want to override a default.
#
# Every value below is optional. Real secrets belong in backend/.env (git-
# ignored), never in this file or in git.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by SQLModel/asyncpg (Phase 6).
# Example: postgresql+asyncpg://user:password@localhost:5432/routellm
# LOCAL-FIRST: leave empty to use SQLite at <data dir>/routellm.db.
DATABASE_URL=

# Redis connection string, used for quota tracking and circuit breaker state.
# Example: redis://localhost:6379/0
# LOCAL-FIRST: leave empty to use an in-process store (no server needed; state
# resets when the process exits).
REDIS_URL=

# ---------------------------------------------------------------------------
# Provider keys — the ONE thing worth configuring.
#
# The recommended path is the Providers page in the UI: keys saved there are
# encrypted with the local encryption key and win over anything in this file.
# These variables are the fallback for when you prefer environment variables.
# Free keys: https://console.groq.com/keys  https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------

# Groq API key, used to call Groq-hosted models.
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini API key, used to call the Gemini API.
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# DeepSeek API key, used to call the DeepSeek API.
# Get one at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Fernet key used to encrypt per-caller provider API keys (BYOK) at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# LOCAL-FIRST: no action needed. When unset, a key is generated once into
# <data dir>/encryption.key with owner-only permissions and reused on every
# later run. Deleting that file makes previously stored provider keys
# unreadable — re-enter them on the Providers page. Set this only to share one
# key across machines or to pin it in a managed deployment.
PROVIDER_KEY_ENCRYPTION_KEY=

# Deployment environment name: "development", "staging", or "production".
ENVIRONMENT=development

# Minimum log level for structured logs: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Rate limit applied to POST /api/v1/route, in slowapi "rate/count" syntax.
# Example: 30/minute or 5/second.
ROUTE_RATE_LIMIT=30/minute

# ---------------------------------------------------------------------------
# Local runtime paths
# ---------------------------------------------------------------------------

# Where SQLite, the generated encryption key and logs live. Defaults to ./data
# next to the repo, falling back to the per-user data directory when the
# checkout is read-only. Git-ignored either way.
# ROUTELLM_DATA_DIR=./data

# Bind address and port. Loopback by default: the gateway spends your provider
# credits, so exposing it to your network is an explicit decision.
# HOST=127.0.0.1
# PORT=8000

# Serve the built frontend (frontend/dist) from the backend so the whole app is
# one URL. Turn off if you run the Vite dev server separately.
# SERVE_FRONTEND=true
# FRONTEND_DIST_DIR=

# ---------------------------------------------------------------------------
# API keys
# ---------------------------------------------------------------------------

# LOCAL-FIRST: false (default) means /api/v1/route and /v1/chat/completions work
# with no X-API-Key; usage is attributed to a stable "Local" identity row, so
# per-caller provider keys and counters still work. Set true to require a
# generated key on every protected route (cloud/team behaviour): generate one
# with POST /api/v1/keys/generate (only its SHA-256 hash is stored).
# Keys are a no-login demo mechanism, not multi-tenant auth.
# REQUIRE_API_KEY=false

# DEV/DEMO ONLY — chaos mode (fault injection for live fallback demos).
# LOCAL-FIRST: true by default, because the app runs on your machine behind
# 127.0.0.1 and "watch the failover" is a headline feature. Set false to keep
# the /api/v1/admin/chaos/*
# endpoints and the executor's fake-failure gate completely inert.
# CHAOS_MODE_ENABLED=true

# ---------------------------------------------------------------------------
# EXPERIMENTAL: ML-assisted routing
# Blends a trained per-prompt provider-classifier (60%) with the rule-based
# capability table (40%). Requires the model artifact
# app/ml_models/router_classifier.pkl — produced by
#   scripts/collect_training_data.py  →  scripts/train_router_model.py
# (ML deps: pip install -r requirements-ml.txt). Without the file the system
# runs 100% rule-based even with the flag on, so this is safe to enable.
ENABLE_ML_ROUTING=false

# ---------------------------------------------------------------------------
# Browser-origin CORS allowlist (comma-separated). Only needed for clients
# that call the backend DIRECTLY cross-origin (VITE_API_BASE_URL set to the
# backend origin). The Cloudflare Worker proxies same-origin server-to-server,
# so it does NOT need an entry here.
# Example: CORS_ORIGINS=http://localhost:5173,https://routellm.example.workers.dev
# Unset: falls back to the Vite dev origins (localhost:5173/4173).
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Hugging Face / managed-host settings (all optional)
# ---------------------------------------------------------------------------

# Port used when the app is started as a script (hf_app.py). Hugging Face
# Spaces require 7860 and inject PORT themselves; uvicorn --port overrides it.
# PORT=7860

# Budget (seconds) for each dependency probe inside /health. Keep it short so
# a sleeping dependency cannot hang the health check.
# HEALTH_PROBE_TIMEOUT_S=2.0

# Where the app may write scratch files. On Hugging Face this defaults to
# /tmp/routellm because the app directory is read-only there.
# ROUTELLM_RUNTIME_DIR=/tmp/routellm

# Force the "app directory is read-only" behavior outside Hugging Face (used by
# the read-only boot test; also handy when baking a read-only image).
# ROUTELLM_READ_ONLY_APP_DIR=0

# DATABASE_URL / REDIS_URL for a managed deployment look like:
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
#   REDIS_URL=rediss://default:<your-password>@HOST:6379
# `postgres://`, `postgresql://` and `postgresql+asyncpg://` are all accepted;
# sslmode= is translated for asyncpg and libpq-only parameters such as
# channel_binding are stripped automatically. rediss:// enables TLS.
#
# CORS_ORIGINS must include the dashboard origin when it calls this backend
# directly (the Cloudflare Worker proxy does not need an entry):
#   CORS_ORIGINS=https://routellm.saboornasar66.workers.dev
