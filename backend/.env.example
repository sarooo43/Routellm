# PostgreSQL connection string used by SQLModel/asyncpg (Phase 6).
# Example: postgresql+asyncpg://user:password@localhost:5432/routellm
DATABASE_URL=

# Redis connection string, used for quota tracking and circuit breaker state (later phases).
# Example: redis://localhost:6379/0
REDIS_URL=

# Groq API key, used to call Groq-hosted models.
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini API key, used to call the Gemini API.
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# DeepSeek API key, used to call the DeepSeek API.
# Get one at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Fernet key used to encrypt per-caller provider API keys (BYOK) at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required for the Provider Keys UI and BYOK routing. When unset, provider-key
# writes and routing for callers with stored provider keys fail closed (503).
PROVIDER_KEY_ENCRYPTION_KEY=

# Deployment environment name: "development", "staging", or "production".
ENVIRONMENT=development

# Minimum log level for structured logs: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Rate limit applied to POST /api/v1/route, in slowapi "rate/count" syntax.
# Example: 30/minute or 5/second.
ROUTE_RATE_LIMIT=30/minute

# Lightweight demo API keys (Phase 16): no environment variable is required.
# Generate keys with POST /api/v1/keys/generate; the DB stores only SHA-256
# hashes. POST /api/v1/route and POST /v1/chat/completions require X-API-Key.
# This is a no-login demo/portfolio system, not production OAuth or multi-tenant
# authentication. Do not treat generated demo keys as production secrets.

# DEV/DEMO ONLY — chaos mode (fault injection for live fallback demos).
# Leave unset (or false) in any real deployment: the /api/v1/admin/chaos/*
# endpoints and the executor's fake-failure gate stay completely inert.
# Set to true to enable the "⚡ Simulate Outage" dashboard controls.
CHAOS_MODE_ENABLED=false

# ---------------------------------------------------------------------------
# EXPERIMENTAL: ML-assisted routing
# Blends a trained per-prompt provider-classifier (60%) with the rule-based
# capability table (40%). Requires the model artifact
# app/ml_models/router_classifier.pkl — produced by
#   scripts/collect_training_data.py  →  scripts/train_router_model.py
# (ML deps: pip install -r requirements-ml.txt). Without the file the system
# runs 100% rule-based even with the flag on, so this is safe to enable.
ENABLE_ML_ROUTING=false
