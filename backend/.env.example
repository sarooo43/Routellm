# PostgreSQL connection string used by SQLModel/asyncpg (Phase 6).
# Example: postgresql+asyncpg://user:password@localhost:5432/routellm
DATABASE_URL=

# Redis connection string, used for quota tracking and circuit breaker state (later phases).
# Example: redis://localhost:6379/0
REDIS_URL=

# Groq API key, used to call Groq-hosted models.
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini API key, used to call the Gemini API.
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# DeepSeek API key, used to call the DeepSeek API.
# Get one at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Deployment environment name: "development", "staging", or "production".
ENVIRONMENT=development

# Minimum log level for structured logs: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Rate limit applied to POST /api/v1/route, in slowapi "rate/count" syntax.
# Example: 30/minute or 5/second.
ROUTE_RATE_LIMIT=30/minute
