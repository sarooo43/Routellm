{
  "name": "routellm-monorepo",
  "private": true,
  "type": "module",
  "description": "RouteLLM gateway monorepo. The React dashboard lives in frontend/; the FastAPI gateway lives in backend/. npm workspaces install frontend dependencies at the root so Cloudflare builds do not need a nested npm ci.",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "build:frontend": "npm run build --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "test": "npm run test --workspace frontend",
    "test:watch": "npm run test:watch --workspace frontend",
    "preview": "npm run preview --workspace frontend",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "wrangler": "^4.156.0"
  }
}
